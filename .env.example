# Azure AI Configuration
# Set USE_AZURE=true to enable Azure AI models
USE_AZURE=false

# Option 1: Azure AI Project (recommended)
# Get this from your Azure AI Studio project settings
AZURE_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Option 2: Azure OpenAI Direct
# AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_INFERENCE_CREDENTIAL=your-api-key
# AZURE_API_VERSION=2024-12-01-preview

# Model names (these should match your deployed model names in Azure)
LANGUAGE_MODEL=gpt-4o
VISION_MODEL=gpt-4o
TEXT_MODEL=text-embedding-3-small

# For non-Azure OpenAI compatible endpoints
# API_BASE=https://api.openai.com/v1

# Note: For Azure AI Project authentication, make sure you're logged in with:
# az login
